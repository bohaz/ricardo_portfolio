---
import Base from "../layouts/Base.astro";
---

<Base lang="en" path="" title="Page not found">
  <section class="wrap py-28">
    <h1 class="text-4xl font-extrabold tracking-tight">This page doesn't exist</h1>
    <p class="mt-3 text-mute" lang="es">Esta página no existe.</p>
    <div class="mt-8 flex gap-6">
      <a class="link-u" href="/en/">Go to the English site</a>
      <a class="link-u" href="/es/" lang="es">Ir al sitio en español</a>
    </div>
  </section>
</Base>
