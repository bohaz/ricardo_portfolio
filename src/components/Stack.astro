---
import { type Lang, ui } from "../data/i18n";

interface Props {
  lang: Lang;
  items: string[];
}

const { lang, items } = Astro.props;
---

<div>
  <h4 class="sr-only">{ui[lang].stack}</h4>
  <ul class="flex flex-wrap gap-2">
    {items.map((item) => <li class="rounded-md bg-raised px-2.5 py-1 text-[0.8125rem] font-medium text-soft">{item}</li>)}
  </ul>
</div>
