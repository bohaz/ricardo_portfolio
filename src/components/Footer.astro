---
import { type Lang, ui } from "../data/i18n";
import { profile } from "../data/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="border-t border-line">
  <div class="wrap flex flex-col gap-3 py-8 text-sm text-mute sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {profile.name}. {ui[lang].footer}</p>
    <ul class="flex gap-5">
      <li><a class="hover:text-white" href={profile.github}>GitHub</a></li>
      <li><a class="hover:text-white" href={profile.linkedin}>LinkedIn</a></li>
      <li><a class="hover:text-white" href={`mailto:${profile.email}`}>Email</a></li>
    </ul>
  </div>
</footer>
