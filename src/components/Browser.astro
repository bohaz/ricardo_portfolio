---
/** Captura de escritorio dentro de una ventana de navegador, para que la página nunca quede cortada en el borde. */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Dirección que se muestra en la barra; si falta, solo se ven los tres puntos. */
  url?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, width, height, url, eager = false, class: className } = Astro.props;
---

<div class:list={["frame frame-browser", className]}>
  <div class="frame-bar" aria-hidden="true">
    <span class="frame-dots"><i></i><i></i><i></i></span>
    {url && <span class="frame-url">{url}</span>}
  </div>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
  />
</div>
