---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { type Lang, otherLang, ui } from "../data/i18n";

interface Props {
  lang: Lang;
  /** Ruta sin el prefijo de idioma, por ejemplo "" o "work/vigia-sms/". */
  path: string;
  title?: string;
  description?: string;
}

const { lang, path, title, description } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} | Ricardo Martínez` : t.metaTitle;
const pageDescription = description ?? t.metaDescription;
const site = Astro.site!;
const canonical = new URL(`/${lang}/${path}`, site).href;
const alternate = new URL(`/${otherLang(lang)}/${path}`, site).href;
const ogImage = new URL("/og-image.png", site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang(lang)} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/en/${path}`, site).href} />
    <meta name="theme-color" content="#050816" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_CL"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Ricardo Martínez",
        jobTitle: lang === "en" ? "Full Stack Developer" : "Desarrollador Full Stack",
        url: canonical,
        email: "mailto:ricardomartinezvet@gmail.com",
        sameAs: ["https://github.com/bohaz", "https://www.linkedin.com/in/ricardomartinezdev/"],
        knowsAbout: ["React", "TypeScript", "Next.js", "Node.js", "Ruby on Rails", "PostgreSQL"],
      })}
    />
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-electric focus:px-4 focus:py-2 focus:font-semibold focus:text-white">
      {t.skip}
    </a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
